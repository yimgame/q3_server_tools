# Ejemplo de configuración de q3_server_tools. Copiar a `.env` (gitignorado) y ajustar.
# Ningún secreto va acá: la rcon password la leen el watcher y el panel de las cfg del juego
# (cpma/cfg/*server*.cfg), que viven en la carpeta de Quake 3, fuera de este repo.

# --- Panel (panel/app.py) ---
PANEL_PORT=3020                       # puerto web del panel
Q3_HOST=192.168.0.202                 # IP donde escuchan los servers (UDP getstatus/rcon)
Q3_BASE=/game                         # carpeta de Quake 3 vista desde el container (baseq3, cpma, instances)
REPO_DIR=/repo                        # este repo visto desde el container (para la solapa Compose)
FASTDL_URL=http://q3dl.ejemplo.com.ar # URL pública del FastDL (sv_dlURL)

# --- Watcher (watcher/q3_watcher.py) — ver watcher/README.md ---
Q3_SERVERS=ctf:27964,tdm:27963,ft:27966,ra3:27967,2v2:27962,ca:27965,ffa:27960,1v1:27961
Q3_RCON_HOST=127.0.0.1
Q3_AAS=1                              # 0 apaga la compilación automática de AAS
Q3_SALUD_SERVER=ctf                   # server que se reinicia solo si no contesta
Q3_SSH_HOST=192.168.0.200             # host con el forced command "restart-ctf"
Q3_SSH_KEY=/root/.ssh/watcher_key     # la key NUNCA va al repo (la copia el container al arrancar)
Q3_MASTERS=master.quake3arena.com,directory.ioquake3.org,master.quakeservers.net:27950,master.maverickservers.com:27950,dpmaster.deathmask.net:27950
Q3_MASTERS_INTERVALO=21600
